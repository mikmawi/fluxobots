{
  "redirects": [
    { "source": "/tienda/:path(.*)", "destination": "/t/:path", "permanent": true }
  ],
  "rewrites": [
    { "source": "/t/:path(.*)", "destination": "https://app.fluxobots.com/t/:path" },
    { "source": "/pedido/:path(.*)", "destination": "https://app.fluxobots.com/pedido/:path" }
  ]
}
